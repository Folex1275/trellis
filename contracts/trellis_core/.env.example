# Trellis Core Contract — environment configuration
#
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# .env files are loaded by the CLI and frontend tooling. Never commit
# a .env file that contains real secret keys.

# Stellar RPC endpoint for the target network (default: Soroban Testnet)
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase used to sign transactions
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Bech32-encoded Trellis contract address on the target network
# TRELLIS_CONTRACT_ID=CAUAO7CYKULE2K4EJMQ6LLRUHP7Y7JYOH6G2VBXKYG7PTETE3UZ3DU7Q